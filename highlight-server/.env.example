# highlight-server 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== Claude API 配置 =====
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ===== 语音识别配置 =====
# 设为 vosk 启用离线语音识别（无字幕时的备选方案）
STT_MODE=vosk
# Vosk 模型目录路径（运行 python download_models.py 后自动生成）
VOSK_MODEL_PATH=

# ===== 启动预热 =====
# 逗号分隔的视频 ID，启动时后台预热规则引擎缓存
WARMUP_VIDEO_IDS=