cache/

# ============================================
# 后端服务 (highlight-server)
# ============================================

# Python 字节码
highlight-server/__pycache__/
*.pyc
*.pyo

# Vosk 语音识别模型（~50MB）
highlight-server/models/

# FFmpeg 二进制（35MB）
highlight-server/ffmpeg/

# 缓存数据
highlight-server/cache/

# 批量计算结果
highlight-server/batch_result.json
highlight-server/test_batch.json

# 测试脚本和内部工具
highlight-server/test_*.py
highlight-server/_*.py
highlight-server/batch_*.py
highlight-server/degradation_test.py
highlight-server/benchmark_test.py
highlight-server/final_test.py
highlight-server/generate_batch_cache.py
highlight-server/download_models.py
highlight-server/download_model.py
highlight-server/regen_comments.py
highlight-server/quick_test.py
highlight-server/export_jit_to_onnx*.py
highlight-server/vad_compare_test.py

# 测试报告和日志
highlight-server/*_report.json
highlight-server/*_log.txt
highlight-server/*_err*.txt
highlight-server/startup_*.txt
highlight-server/server*.log
highlight-server/server*.txt

# 部署文档
highlight-server/*.md

# pytest 和 torch 缓存
highlight-server/.pytest_cache/
highlight-server/.torch_cache/
.pytest_cache/

# TTS 缓存
highlight-server/tts_cache/

# 调试音频文件
highlight-server/debug_*.mp3
highlight-server/debug_*.wav

# 批量结果文件
highlight-server/batch_result*.json
highlight-server/_test_*.json
highlight-server/_quality_*.json
highlight-server/_quality_*.txt

# 部署和运维脚本
highlight-server/*.sh
highlight-server/*.bat
highlight-server/*.yml

# 根目录文件
batch_result*.json
screen.png
highlight-server/batch_run_output.txt

